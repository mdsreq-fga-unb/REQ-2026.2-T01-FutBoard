# =============================================================================
# FutBoard - Variáveis de Ambiente de Desenvolvimento
# Copie este arquivo para .env antes de iniciar os containers:
#   Linux/macOS: cp .env.example .env
#   Windows (PowerShell): Copy-Item .env.example .env
# =============================================================================

# --- Banco de Dados (PostgreSQL) ---
POSTGRES_DB=futboard
POSTGRES_USER=futboard
POSTGRES_PASSWORD=futboard-dev
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend (Django + Django REST Framework) ---
DJANGO_SECRET_KEY=django-insecure-local-development-only-change-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (React + Vite) ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api
